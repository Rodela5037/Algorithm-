#include <iostream>
using namespace std;

int main() {
    int a[] = {5, 3, 4, 1, 2};

    for (int i = 1; i < 5; i++) {
        for (int j = i; j > 0; j--) {
            if (a[j-1] > a[j]) {
                int temp = a[j];
                a[j] = a[j - 1];
                a[j - 1] = temp;
            }
        }
    }
    for (int i = 0; i < 5; i++)
        cout << a[i] << " ";

    return 0;
}


